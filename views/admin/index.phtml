<?php
/**
 * The Documentation screen - see `DocsAdminController::index()`
 *
 * The tree is the core's `dpress_admin:tree` with nothing to drag: the order is the source's
 * toctrees, and it changes where they are written.
 *
 * Expects: $source, $public_url, $last (`lastBuild()`, or null), $status (`status()`),
 * $build_url ('' without the permission), $settings_url, $rows, $columns, $row_actions,
 * $changes_url (where `docs-admin.js` asks git what differs from the remote).
 */
$hammer = \Dynart\Dpress\Dpress::iconFile(dirname(__DIR__, 2).'/icons/hammer.svg');
?>
<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1>Documentation</h1>
        <span class="spacer"></span>
        <a class="button with-icon" href="<?= esc_attr($settings_url) ?>"><?= \Dynart\Dpress\Dpress::icon('settings') ?> Settings</a>
        <?php if ($build_url !== ''): ?>
            <button type="button" class="button primary with-icon"
                    onclick="Dpress.post(<?= esc_attr(json_encode($build_url)) ?>)"><?= $hammer ?> Build now</button>
        <?php endif ?>
    </div>

    <?php // filled in by docs-admin.js: every file that differs from the remote, and the tree's badges ?>
    <div data-docs-changes="<?= esc_attr($changes_url) ?>"></div>

    <div class="panel docs-status">
        <dl>
            <dt>Source folder</dt>
            <dd><?= $source !== '' ? '<code>'.esc_html($source).'</code>' : 'Not set - the Settings has it, in the Documentation section.' ?><?=
                    !empty($pulls) ? ' - pulled with git before every build' : '' ?></dd>
            <dt>Address</dt>
            <dd><a href="<?= esc_attr($public_url) ?>"><?= esc_html($public_url) ?></a></dd>
            <dt>Last build</dt>
            <dd>
                <?php if ($last === null): ?>
                    Not built yet.
                <?php else: ?>
                    <?php if (!empty($last['update'])): ?>
                        <?= esc_html((string)$last['update']) ?><br>
                    <?php endif ?>
                    <?= esc_html(substr((string)$last['at'], 0, 16)) ?> UTC -
                    <?= (int)$last['pages'] > 0 ? (int)$last['pages'].' page(s)' : 'nothing was built' ?><?=
                        empty($last['problems']) ? ', no problems.' : ', '.(count($last['problems']) + (int)($last['more'] ?? 0)).' thing(s) to look at:' ?>
                    <?php if (!empty($last['problems'])): ?>
                        <ul class="docs-problems">
                            <?php foreach ($last['problems'] as $problem): ?>
                                <li><?php if ((string)$problem['file'] !== ''): ?><code><?= esc_html((string)$problem['file']) ?></code>: <?php endif ?><?= esc_html((string)$problem['message']) ?></li>
                            <?php endforeach ?>
                            <?php if ((int)($last['more'] ?? 0) > 0): ?>
                                <li>And <?= (int)$last['more'] ?> more - <code>dpress docs:build</code> lists them all.</li>
                            <?php endif ?>
                        </ul>
                    <?php endif ?>
                <?php endif ?>
            </dd>
            <?php if ($last !== null && (int)$last['pages'] === 0 && (int)$status['pages'] > 0): ?>
                <dt>On the site</dt>
                <dd><?= (int)$status['pages'] ?> page(s) from the build of <?= esc_html(substr((string)$status['built_at'], 0, 16)) ?> UTC - a build that makes nothing takes nothing down.</dd>
            <?php endif ?>
        </dl>
    </div>

    <?php // `docs-admin.js` folds the tree to its chapters and filters it by the search - without it,
          // the whole tree is here, open, which is what it was before either existed ?>
    <div class="docs-pages" data-docs-tree>
        <?php if (!empty($rows)): ?>
            <div class="filters">
                <input type="search" placeholder="Search pages by title or file" aria-label="Search pages"
                       data-docs-tree-search autocomplete="off">
            </div>
        <?php endif ?>
        <?= $this->fetch('dpress_admin:tree', [
            'rows'       => $rows,
            'columns'    => $columns,
            'rowActions' => $row_actions,
            'empty'      => 'Nothing is built yet.',
        ]) ?>
    </div>
<?php $this->endBlock() ?>
