<?php
/**
 * A page's source file in the Markdown editor - see `DocsAdminController::edit()`
 *
 * Expects: $title, $source (the file, relative to the source folder), $changes_url (where
 * `docs-admin.js` asks whether it differs from the remote), $form, $view_url, $back_url.
 */
?>
<?php $this->useLayout($admin_layout) ?>
<?php $this->startBlock('content') ?>
    <div class="page-head">
        <h1><?= esc_html($title) ?></h1>
        <span class="spacer"></span>
        <a class="button" href="<?= esc_attr($view_url) ?>">View</a>
        <a class="button with-icon" href="<?= esc_attr($back_url) ?>" data-back><?= \Dynart\Dpress\Dpress::icon('back') ?> Back</a>
    </div>

    <?php // filled in by docs-admin.js: whether this file differs from the remote ?>
    <div data-docs-changes="<?= esc_attr($changes_url) ?>"></div>

    <div class="panel">
        <p class="form-description docs-source-file"><code><?= esc_html($source) ?></code></p>
        <form method="post">
            <?= $form->fetch() ?>
            <div class="form-actions">
                <a class="button" href="<?= esc_attr($back_url) ?>">Cancel</a>
                <button type="submit" class="primary with-icon"><?= \Dynart\Dpress\Dpress::icon('save') ?> Save</button>
            </div>
        </form>
    </div>
<?php $this->endBlock() ?>
