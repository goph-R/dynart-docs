<?php
/**
 * The Build button and what the last build left - see `DocsSettings`
 *
 * A button rather than a submit: it must not send the settings form, which is saved by Save. It
 * posts through the admin's action form, `Dpress.post()`, the way every other write here does,
 * so it carries the action token and nothing of the boxes around it.
 *
 * @var array $field `url`, `status`
 */
?>
<div class="docs-build">
    <button type="button" class="button with-icon"
            onclick="Dpress.post(<?= esc_attr(json_encode((string)($field['url'] ?? ''))) ?>)"><?= \Dynart\Dpress\Dpress::iconFile(dirname(__DIR__, 2).'/icons/hammer.svg') ?> Build now</button>
    <span class="form-description" style="display: inline; margin-left: 10px;"><?= esc_html((string)($field['status'] ?? '')) ?></span>
</div>
